# saas-identity-platform-aspnetcore — 开发期环境变量模板
#
# L0.5 env 一致性门管理三件套：.env.example（dev）/.env.test（vitest）/.env.production（deploy）
# key 集合严格相等；secret 值由 deploy 脚本注入（不 commit 真密钥）。
# L4.db.* 真跑需 dev 机器配真 PG（100.79.128.25:5432 + saas_dev/saas_test 库）；
# 跑 gate 默认补 env 即跑。无 PG 时 stack.json 的 skip_env 仍可让 L4.db.* 跳过。

# —— Server ——
SERVER_PORT=5104

# —— Database（saas_dev 数据库, 全家族统一 PG_* 五件套） ——
# 默认 Host=100.79.128.25;Port=5432（与 lab 共享 dev 入口）
PG_HOST=100.79.128.25
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=changeme
PG_DATABASE=saas_dev

# —— JWT (HS256, ≥32B 硬约束, 全家族镜像同一 JWT_SIGNING_KEY) ——
# SSO 模式: react/vue/nextjs 验签 saas 签发的 token
# no-sso profile: 真后端真签（aspnetcore JwtIssuer / springboot JwtIssuer / nextjs jose）
# prod 路径: deploy 脚本首启自举随机密钥持久化进 env-file
JWT_SIGNING_KEY=dev-key-32-bytes-minimum-length!
JWT_ISSUER=saas-identity-platform
JWT_AUDIENCE=saas-identity-platform-clients
JWT_TTL_SECONDS=3600

# —— CORS allowed origins (SSO 跨域用) ——
# ADR-0014: 全家族 backend 共享
SAAS_CORS_ALLOWED_ORIGINS=http://localhost:5101,http://localhost:5102,http://localhost:5103


# —— 兼容 deploy 脚本（saas-identity-platform-*.sh / setup-vps.sh 用 DATABASE_URL 单串） ——
# 注: Program.cs 读 flat JWT_* + SAAS_CORS；springboot 读 yml 占位符 + DATABASE_URL。
# DATABASE_URL 整串由 deploy 脚本从 VPS saas.env 注入，dev 阶段可手填。
DATABASE_URL=postgresql://postgres:qiand68%2B%2B%2B@100.79.128.25:5432/saas_dev
DATABASE_NAME=saas_dev

# —— 兼容 deploy 脚本（saas-identity-platform-*.sh + setup-vps.sh 老 key） ——
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme
JWT_AUTHORITY=https://auth.example.com
# —— Login 失败锁定（nextjs-only, LOCKOUT_* 三件套） ——

# —— OAuth token TTL（nextjs-only, OAUTH_* 二件套） ——
