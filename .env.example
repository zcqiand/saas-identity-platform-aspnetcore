# saas-identity-platform-aspnetcore — 开发期环境变量模板
#
# appsettings.json 是 SSOT；本文件列出可用 env override（ASP.NET 标准
# 双下划线 Section__Key 或冒号 Section:Key 自动覆盖）。

# —— Server ——
ASPNETCORE_URLS=http://localhost:5000

# —— Database（saas_dev 数据库） ——
# 默认 Host=100.79.128.25;Port=5432;Database=saas_dev
ConnectionStrings__Postgres=Host=100.79.128.25;Port=5432;Database=saas_dev;Username=postgres;Password=changeme
SAAS_DB=saas_dev

# —— CORS ——
# 逗号分隔允许 origin，覆盖 appsettings.json 默认列表。
# 默认：saas-nextjs :3000 + lab-react,vue :5173 + lab-nextjs :3001
# 跨仓对称：springboot SecurityConfig 也读 SAAS_CORS_ALLOWED_ORIGINS。
SAAS_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001

# —— saas-identity-platform 跨 origin ——
# 仅 dev：本仓 :5000 → saas-nextjs :3000（API 路由），无需 reverse proxy

# —— JWT ——
Jwt__Authority=https://auth.example.com
Jwt__Issuer=saas-identity-platform
Jwt__Audience=saas-identity-platform-clients
Jwt__SigningKey=dev-key-32-bytes-minimum-length!