# saas-identity-platform-aspnetcore — 开发期环境变量模板
#
# appsettings.json 是 SSOT；本文件列出可用 env override（ASP.NET env provider
# 把 flat key 直接当 flat config 读，Phase 4 env 对称化后去掉双下划线段映射）。

# —— Server ——
# SERVER_PORT 是全家族统一监听 key（Program.cs ServerPortShim 接线; aspnetcore=5000 conventions §6）。
SERVER_PORT=5000

# —— Database（saas_dev 数据库） ——
# 默认 Host=100.79.128.25;Port=5432;Database=saas_dev
DATABASE_URL=Host=100.79.128.25;Port=5432;Database=saas_dev;Username=postgres;Password=changeme
DATABASE_NAME=saas_dev

# —— CORS ——
# 逗号分隔允许 origin，覆盖 appsettings.json 默认列表。
# 默认：saas-nextjs :3000 + lab-react,vue :5173 + lab-nextjs :3001
# 跨仓对称：springboot SecurityConfig 也读 SAAS_CORS_ALLOWED_ORIGINS。
SAAS_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001

# —— saas-identity-platform 跨 origin ——
# 仅 dev：本仓 :5000 → saas-nextjs :3000（API 路由），无需 reverse proxy

# —— JWT (Phase 4 env 对称化: 顶层 flat key, 镜像 saas-springboot JWT_SIGNING_KEY 等) ——
# 9 仓共享 dev-key-32-bytes-minimum-length!: saas-{springboot,aspnetcore,nextjs,msw,react,vue}
# + lab-{springboot,aspnetcore,nextjs,msw,react,vue} + saas/lab 6 个前端仓 env 全对齐。
JWT_AUTHORITY=https://auth.example.com
JWT_ISSUER=saas-identity-platform
JWT_AUDIENCE=saas-identity-platform-clients
JWT_SIGNING_KEY=dev-key-32-bytes-minimum-length!
JWT_TTL_SECONDS=3600
