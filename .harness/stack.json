{
  "schema": 1,
  "project": "saas-identity-platform-aspnetcore",
  "stack": "aspnetcore",
  "suite_version": "0.5.0",
  "source_dirs": ["src"],
  "test_dirs": ["tests"],
  "gates": {
    "L1": { "name": "格式", "cmd": ["dotnet", "format", "--verify-no-changes", "--include", "src/**", "tests/**"], "fix": "dotnet format" },
    "L2": { "name": "静态检查", "cmd": ["dotnet", "build", "/p:TreatWarningsAsErrors=true"], "fix": "逐条修复 warning" },
    "L3": { "name": "编译", "cmd": ["dotnet", "build", "--no-restore"], "fix": "先让它编译过" },
    "L4": { "name": "测试", "cmd": ["dotnet", "test", "--no-build"], "fix": "先让测试变绿" }
  },
  "trace_cmd": ["dotnet", "test", "--no-build", "--logger", "console;verbosity=normal"],
  "trace_env": { "TRACE_MAP": "1" }
}
