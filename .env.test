# .env.test — saas-identity-platform-aspnetcore L4 测试期覆盖
#
# JWT_SIGNING_KEY 与 saas-identity-platform-msw 共享 (≥32B 硬约束)。
# L4 单元测试用 JwtIssuer.IssueAccessTokenForTest 真签 + JwtBearer 真验签，共享
# dev key 保证：test fixture → test verifier 闭环跑通。
# Phase 2B 起：原 RequireSignedTokens=false alg=none 路径已删除。
# Phase 4 env 对称化: Jwt__SigningKey → JWT_SIGNING_KEY flat key。

JWT_SIGNING_KEY=dev-key-32-bytes-minimum-length!
JWT_ISSUER=saas-identity-platform
JWT_AUDIENCE=saas-identity-platform-clients
JWT_TTL_SECONDS=3600

# —— 以下 key 与 .env.example 全集对齐（T12;test 不起真 DB,占 dev 值） ——
SERVER_PORT=5000
DATABASE_URL=Host=100.79.128.25;Port=5432;Database=saas_dev;Username=postgres;Password=changeme
DATABASE_NAME=saas_dev
SAAS_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001
JWT_AUTHORITY=https://auth.example.com
